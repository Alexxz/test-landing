  "findings": [
    "Successful samples have input events in all four fields and confirmed conversion.",
    "All three CTA-abandonment samples contain no rrweb input events and no field clicks after CTA; they continue scrolling before exit.",
    "CTA-to-exit time in the three abandonment samples is approximately 6.2 to 6.6 seconds.",
    "Repeated top-edge clicks and collapsed selection attempts occur in both successful and unsuccessful samples; they do not distinguish conversion outcome.",
    "Early exit contains programmatic-looking clicks at (0,0) on cards with hit-test mismatches. Intent cannot be inferred from those clicks."
  ],
  "implications": [
    "Do not describe observed drop-off as field validation failure or difficulty finishing purpose: sampled abandonments never begin typing.",
    "Early CTA hypothesis remains experimental; no causal evidence yet.",
    "Next hypotheses should address decision to begin filling and page friction, with rrweb samples reviewed alongside aggregate events."
  ]
}
